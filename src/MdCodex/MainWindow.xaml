<Window x:Class="MdCodex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:MdCodex"
        Title="MD Codex" Height="820" Width="1320" MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{DynamicResource Chrome.Fondo}" Foreground="{DynamicResource Chrome.Texto}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="Nuevo_Executed" />
        <CommandBinding Command="Open" Executed="Abrir_Executed" />
        <CommandBinding Command="Save" Executed="Guardar_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="SaveAs" Executed="GuardarComo_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.GuardarTodo}" Executed="GuardarTodo_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.CerrarPestana}" Executed="CerrarPestana_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.CerrarTodas}" Executed="CerrarTodas_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.PestanaSiguiente}" Executed="PestanaSiguiente_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.PestanaAnterior}" Executed="PestanaAnterior_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="Close" Executed="Cerrar_Click" />
        <CommandBinding Command="Refresh" Executed="Recargar_Executed" CanExecute="HayArchivo_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.AbrirCarpeta}" Executed="AbrirCarpeta_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.ModoVista}" Executed="ModoVista_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.ModoDividido}" Executed="ModoDividido_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.ModoEditor}" Executed="ModoEditor_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.ModoPro}" Executed="ModoPro_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.VerExplorador}" Executed="VerExplorador_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.VerEsquema}" Executed="VerEsquema_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.AlternarLateral}" Executed="AlternarLateral_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.Negrita}" Executed="Negrita_Executed" CanExecute="EditorVisible_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.Cursiva}" Executed="Cursiva_Executed" CanExecute="EditorVisible_CanExecute" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="New" />
        <KeyBinding Key="O" Modifiers="Control" Command="Open" />
        <KeyBinding Key="S" Modifiers="Control" Command="Save" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="SaveAs" />
        <KeyBinding Key="F5" Command="Refresh" />
        <KeyBinding Key="W" Modifiers="Control" Command="{x:Static local:Comandos.CerrarPestana}" />
        <KeyBinding Key="F4" Modifiers="Control" Command="{x:Static local:Comandos.CerrarPestana}" />
        <KeyBinding Key="PageDown" Modifiers="Control" Command="{x:Static local:Comandos.PestanaSiguiente}" />
        <KeyBinding Key="PageUp" Modifiers="Control" Command="{x:Static local:Comandos.PestanaAnterior}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static local:Comandos.ModoVista}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static local:Comandos.ModoDividido}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static local:Comandos.ModoEditor}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static local:Comandos.ModoPro}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{x:Static local:Comandos.VerExplorador}" />
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{x:Static local:Comandos.VerEsquema}" />
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{x:Static local:Comandos.AlternarLateral}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{x:Static local:Comandos.Negrita}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{x:Static local:Comandos.Cursiva}" />
    </Window.InputBindings>

    <Border x:Name="Raiz">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="*" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <!-- ===== Barra de título ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="M↓" FontWeight="Bold" FontSize="13" Margin="14,0,8,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Acento}" />

                <!-- Menús: botones planos que abren su lista, como en VS Code -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BotonMenu}" Content="_Archivo" Click="AbrirMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                        <MenuItem Header="_Nuevo" Command="New" InputGestureText="Ctrl+N" />
                        <MenuItem Header="_Abrir archivo…" Command="Open" InputGestureText="Ctrl+O" />
                        <MenuItem Header="Abrir _carpeta…" Command="{x:Static local:Comandos.AbrirCarpeta}" />
                        <Separator />
                        <MenuItem Header="_Guardar" Command="Save" InputGestureText="Ctrl+S" />
                        <MenuItem Header="Guardar _como…" Command="SaveAs" InputGestureText="Ctrl+Mayús+S" />
                        <MenuItem Header="Guardar _todo" Command="{x:Static local:Comandos.GuardarTodo}" />
                        <Separator />
                        <MenuItem Header="Cerrar _pestaña" Command="{x:Static local:Comandos.CerrarPestana}" InputGestureText="Ctrl+W" />
                        <MenuItem Header="Cerrar to_das las pestañas" Command="{x:Static local:Comandos.CerrarTodas}" />
                        <Separator />
                        <MenuItem Header="_Recargar desde el disco" Command="Refresh" InputGestureText="F5" />
                        <Separator />
                        <MenuItem Header="_Salir" Command="Close" InputGestureText="Alt+F4" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource BotonMenu}" Content="_Editar" Click="AbrirMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                        <MenuItem Header="_Deshacer" Command="Undo" InputGestureText="Ctrl+Z" />
                        <MenuItem Header="_Rehacer" Command="Redo" InputGestureText="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="Cor_tar" Command="Cut" InputGestureText="Ctrl+X" />
                        <MenuItem Header="_Copiar" Command="Copy" InputGestureText="Ctrl+C" />
                        <MenuItem Header="_Pegar" Command="Paste" InputGestureText="Ctrl+V" />
                        <Separator />
                        <MenuItem Header="_Buscar" Command="Find" InputGestureText="Ctrl+F" />
                        <Separator />
                        <MenuItem Header="_Negrita" Command="{x:Static local:Comandos.Negrita}" InputGestureText="Ctrl+B" />
                        <MenuItem Header="_Cursiva" Command="{x:Static local:Comandos.Cursiva}" InputGestureText="Ctrl+I" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource BotonMenu}" Content="_Ver" Click="AbrirMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                        <MenuItem Header="_Vista" Command="{x:Static local:Comandos.ModoVista}" InputGestureText="Ctrl+1" />
                        <MenuItem Header="_Dividido" Command="{x:Static local:Comandos.ModoDividido}" InputGestureText="Ctrl+2" />
                        <MenuItem Header="_Editor" Command="{x:Static local:Comandos.ModoEditor}" InputGestureText="Ctrl+3" />
                        <MenuItem Header="_Pro (por bloques)" Command="{x:Static local:Comandos.ModoPro}" InputGestureText="Ctrl+4" />
                        <Separator />
                        <MenuItem Header="E_xplorador" Command="{x:Static local:Comandos.VerExplorador}" InputGestureText="Ctrl+Mayús+E" />
                        <MenuItem Header="E_squema" Command="{x:Static local:Comandos.VerEsquema}" InputGestureText="Ctrl+Mayús+O" />
                        <MenuItem Header="_Barra lateral" Command="{x:Static local:Comandos.AlternarLateral}" InputGestureText="Ctrl+Mayús+B" />
                        <Separator />
                        <MenuItem Header="Pestaña _siguiente" Command="{x:Static local:Comandos.PestanaSiguiente}" InputGestureText="Ctrl+Tab" />
                        <MenuItem Header="Pestaña _anterior" Command="{x:Static local:Comandos.PestanaAnterior}" InputGestureText="Ctrl+Mayús+Tab" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource BotonMenu}" Content="A_yuda" Click="AbrirMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="_Repositorio en GitHub" Click="Repositorio_Click" />
                                <MenuItem Header="_Informar un problema…" Click="InformarProblema_Click" />
                                <Separator />
                                <MenuItem Header="_Acerca de MD Codex" Click="AcercaDe_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TituloVentana" Grid.Column="2" FontSize="12" Margin="12,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Chrome.Tenue}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ToggleButton x:Name="BotonLateral" Style="{StaticResource AlternarIcono}"
                                  Command="{x:Static local:Comandos.AlternarLateral}" ToolTip="Barra lateral (Ctrl+Mayús+B)">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1" Data="M1.5,2.5 H14.5 V13.5 H1.5 Z M5.5,2.5 V13.5" Width="16" Height="16" />
                    </ToggleButton>
                    <Rectangle Width="1" Height="16" Margin="6,0" Fill="{DynamicResource Chrome.Borde}" />
                    <RadioButton x:Name="BotonVista" GroupName="Modo" Style="{StaticResource AlternarIcono}"
                                 Tag="Vista" Checked="BotonModo_Checked" Content="&#xE890;" ToolTip="Vista (Ctrl+1)" />
                    <RadioButton x:Name="BotonDividido" GroupName="Modo" Style="{StaticResource AlternarIcono}" Margin="2,0"
                                 Tag="Dividido" Checked="BotonModo_Checked" ToolTip="Editor y vista (Ctrl+2)">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1" Data="M1.5,2.5 H14.5 V13.5 H1.5 Z M8,2.5 V13.5" Width="16" Height="16" />
                    </RadioButton>
                    <RadioButton x:Name="BotonEditor" GroupName="Modo" Style="{StaticResource AlternarIcono}"
                                 Tag="Editor" Checked="BotonModo_Checked" Content="&#xE70F;" ToolTip="Editor (Ctrl+3)" />
                    <RadioButton x:Name="BotonPro" GroupName="Modo" Style="{StaticResource AlternarIcono}" Margin="2,0,0,0"
                                 Tag="Pro" Checked="BotonModo_Checked" ToolTip="Pro: edición por bloques, como Notion (Ctrl+4)">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1" Width="16" Height="16"
                              Data="M4.5,2.5 H14 V6.5 H4.5 Z M4.5,9.5 H14 V13.5 H4.5 Z M1.5,3.5 V5.5 M1.5,10.5 V12.5" />
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource BotonVentana}" Content="&#xE921;" Click="Minimizar_Click" ToolTip="Minimizar" />
                    <Button x:Name="BotonMaximizar" Style="{StaticResource BotonVentana}" Content="&#xE922;" Click="Maximizar_Click" ToolTip="Maximizar" />
                    <Button Style="{StaticResource BotonCerrar}" Content="&#xE8BB;" Click="Cerrar_Click" ToolTip="Cerrar" />
                </StackPanel>
            </Grid>

            <!-- ===== Cuerpo ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition x:Name="ColumnaLateral" Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <!-- Barra de actividad -->
                <StackPanel Grid.Column="0">
                    <ToggleButton x:Name="ActividadExplorador" Style="{StaticResource BotonActividad}" Tag="Explorador"
                                  Click="Actividad_Click" Content="&#xE8B7;" ToolTip="Explorador (Ctrl+Mayús+E)" />
                    <ToggleButton x:Name="ActividadEsquema" Style="{StaticResource BotonActividad}" Tag="Esquema"
                                  Click="Actividad_Click" Content="&#xE8FD;" ToolTip="Esquema (Ctrl+Mayús+O)" />
                </StackPanel>

                <!-- Barra lateral -->
                <DockPanel x:Name="Lateral" Grid.Column="1">
                    <Grid DockPanel.Dock="Top" Height="35" Margin="20,0,8,0">
                        <TextBlock x:Name="TituloLateral" Style="{StaticResource EtiquetaTenue}" Text="EXPLORADOR" />
                        <StackPanel x:Name="AccionesExplorador" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource BotonIcono}" FontSize="14" Content="&#xED25;"
                                    Command="{x:Static local:Comandos.AbrirCarpeta}" ToolTip="Abrir carpeta…" />
                            <Button Style="{StaticResource BotonIcono}" FontSize="14" Content="&#xE72C;"
                                    Click="RefrescarArbol_Click" ToolTip="Actualizar el explorador" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <DockPanel x:Name="PanelExplorador">
                            <TextBlock x:Name="NombreCarpeta" DockPanel.Dock="Top" FontSize="11" FontWeight="Bold" Margin="20,0,8,4" />
                            <TreeView x:Name="Arbol" Background="Transparent" BorderThickness="0" Padding="6,0"
                                      PreviewMouseLeftButtonUp="Arbol_PreviewMouseLeftButtonUp" KeyDown="Arbol_KeyDown"
                                      MouseDoubleClick="Arbol_MouseDoubleClick">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding Expandido, Mode=TwoWay}" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="2,1" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type local:NodoArchivo}" ItemsSource="{Binding Hijos}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource Iconos}" FontSize="13"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Chrome.Tenue}" />
                                            <TextBlock x:Name="Nombre" Text="{Binding Nombre}" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EsActual}" Value="True">
                                                <Setter TargetName="Nombre" Property="Foreground" Value="{DynamicResource Acento}" />
                                                <Setter TargetName="Nombre" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                        <StackPanel x:Name="ExploradorVacio" Margin="20,4,16,0">
                            <TextBlock Text="No hay ninguna carpeta abierta." TextWrapping="Wrap" Foreground="{DynamicResource Chrome.Tenue}" />
                            <Button Content="Abrir carpeta" Command="{x:Static local:Comandos.AbrirCarpeta}"
                                    HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                        </StackPanel>
                        <ListBox x:Name="ListaEsquema" Background="Transparent" BorderThickness="0" Padding="6,0"
                                 PreviewMouseLeftButtonUp="ListaEsquema_PreviewMouseLeftButtonUp">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="10,4" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:Titulo}">
                                    <TextBlock Text="{Binding Texto}" Margin="{Binding Sangria}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EsquemaVacio" Text="El documento no tiene títulos." Margin="20,4,16,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Chrome.Tenue}" />
                    </Grid>
                </DockPanel>

                <GridSplitter x:Name="DivisorLateral" Grid.Column="2" Width="4" Style="{StaticResource Divisor}" />

                <!-- Espacio de trabajo: pestañas tipo carpeta de archivador sobre un panel redondeado -->
                <Grid Grid.Column="3" Margin="0,0,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Bajan 1 px sobre el borde superior del panel: la pestaña activa lo tapa y se une a él -->
                    <ScrollViewer x:Name="DesplazadorPestanas" Grid.Row="0" Height="37" Margin="0,0,0,-1" Panel.ZIndex="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="DesplazadorPestanas_PreviewMouseWheel">
                        <ItemsControl x:Name="BarraPestanas" Margin="0,3,0,0" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:Pestana}">
                                    <Border x:Name="Fondo" Height="34" MinWidth="90" MaxWidth="240" Padding="12,0,6,0" Margin="0,0,2,0"
                                            Background="Transparent" CornerRadius="8,8,0,0"
                                            BorderThickness="1,1,1,0" BorderBrush="Transparent"
                                            ToolTip="{Binding Descripcion}" MouseDown="Pestana_MouseDown">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Cerrar" InputGestureText="Ctrl+W" Click="MenuCerrar_Click" />
                                                <MenuItem Header="Cerrar otras" Click="MenuCerrarOtras_Click" />
                                                <MenuItem Header="Cerrar a la derecha" Click="MenuCerrarDerecha_Click" />
                                                <MenuItem Header="Cerrar todas" Click="MenuCerrarTodas_Click" />
                                                <Separator />
                                                <MenuItem Header="Copiar ruta" Click="MenuCopiarRuta_Click" IsEnabled="{Binding TieneRuta}" />
                                                <MenuItem Header="Mostrar en el Explorador de Windows" Click="MenuMostrarEnCarpeta_Click" IsEnabled="{Binding TieneRuta}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <Button x:Name="Cerrar" DockPanel.Dock="Right" Style="{StaticResource BotonCerrarPestana}"
                                                    Margin="6,0,0,0" Opacity="0" Click="CerrarPestana_Click" ToolTip="Cerrar (Ctrl+W)" />
                                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Iconos}" FontSize="13" Margin="0,0,6,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Acento}" />
                                            <TextBlock x:Name="Nombre" Text="{Binding Nombre}" FontSize="13" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Chrome.Tenue}" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Fondo}" Value="True">
                                            <Setter TargetName="Cerrar" Property="Opacity" Value="1" />
                                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Modificado}" Value="True">
                                            <Setter TargetName="Cerrar" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EsTemporal}" Value="True">
                                            <Setter TargetName="Nombre" Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Editor.Fondo}" />
                                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource Chrome.Borde}" />
                                            <Setter TargetName="Nombre" Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
                                            <Setter TargetName="Cerrar" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border x:Name="Tarjeta" Grid.Row="1" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource Chrome.Borde}" Background="{DynamicResource Editor.Fondo}">
                    <Grid x:Name="AreaTrabajo">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnaEditor" Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="ColumnaVista" Width="*" />
                        </Grid.ColumnDefinitions>
                        <ae:TextEditor x:Name="Editor" Grid.Column="0" FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                       ShowLineNumbers="True" WordWrap="True" Padding="6,4" />
                        <GridSplitter x:Name="Divisor" Grid.Column="1" Width="4" Style="{StaticResource Divisor}" />
                        <!-- Control de composición: se dibuja dentro de WPF, así respeta las esquinas redondeadas del panel -->
                        <wv2:WebView2CompositionControl x:Name="Visor" Grid.Column="2" />
                        <!-- Modo Pro: editor por bloques (Milkdown Crepe). Se inicia la primera vez que se usa. -->
                        <wv2:WebView2CompositionControl x:Name="VisorPro" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed" />
                    </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== Barra de estado ===== -->
            <Grid Grid.Row="2" Background="{DynamicResource Estado.Fondo}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0">
                    <Button Style="{StaticResource ItemEstado}" Command="{x:Static local:Comandos.AbrirCarpeta}" ToolTip="Abrir carpeta…">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Iconos}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="EstadoCarpeta" Text="Sin carpeta" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EstadoModo" Style="{StaticResource ItemEstado}" Click="EstadoModo_Click" ToolTip="Cambiar de modo" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button x:Name="EstadoPosicion" Style="{StaticResource ItemEstado}" />
                    <Button x:Name="EstadoPalabras" Style="{StaticResource ItemEstado}" />
                    <Button x:Name="EstadoCodificacion" Style="{StaticResource ItemEstado}" ToolTip="Codificación del archivo" />
                    <Button x:Name="EstadoFinLinea" Style="{StaticResource ItemEstado}" ToolTip="Fin de línea" />
                    <Button x:Name="EstadoLenguaje" Style="{StaticResource ItemEstado}" Content="Markdown" />
                    <!-- Marca del desarrollador -->
                    <Button Style="{StaticResource ItemEstado}" Click="AcercaDe_Click" ToolTip="skolldev · Acerca de MD Codex">
                        <Rectangle Width="14" Height="14" Fill="{DynamicResource Estado.Texto}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Recursos/skolldev-silueta.png" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
