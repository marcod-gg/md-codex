<Window x:Class="MdCodex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:MdCodex"
        Title="MD Codex" Height="820" Width="1320" MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Icon="/Recursos/mdcodex.ico"
        Background="{DynamicResource Chrome.Fondo}" Foreground="{DynamicResource Chrome.Texto}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- Nodos de los árboles de la barra lateral (Espacios de trabajo y Documentos) -->
    <Window.Resources>
        <!-- Plantilla propia: la estándar da al encabezado ancho ilimitado y los nombres
             largos se cortan en seco en vez de terminar en "…" -->
        <Style x:Key="EstiloNodo" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding Expandido, Mode=TwoWay}" />
            <!-- Documentos: los recién llegados a un grupo entran con animación -->
            <EventSetter Event="Loaded" Handler="Nodo_Loaded" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Fila" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <ToggleButton x:Name="Flecha" DockPanel.Dock="Left" Width="20" Focusable="False"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <TextBlock x:Name="Icono" Text="&#xE76C;" FontFamily="{StaticResource Iconos}" FontSize="9"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Chrome.Tenue}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Icono" Property="Text" Value="&#xE70D;" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <!-- ClipToBounds: al animar la altura, lo que no cabe se recorta en vez de desbordar -->
                            <ItemsPresenter x:Name="Hijos" Margin="16,0,0,0" Visibility="Collapsed" ClipToBounds="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Hijos" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Flecha" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="Fila" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fila" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fila" Property="Background" Value="{DynamicResource Chrome.Activo}" />
                            </Trigger>
                            <!-- Carpeta donde caería el archivo que se arrastra -->
                            <DataTrigger Binding="{Binding EsDestino}" Value="True">
                                <Setter TargetName="Fila" Property="Background" Value="{DynamicResource Chrome.Activo}" />
                                <Setter TargetName="Fila" Property="BorderBrush" Value="{DynamicResource Acento}" />
                                <Setter TargetName="Fila" Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Grupo de Documentos sin documentos -->
                <DataTrigger Binding="{Binding Oculto}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <HierarchicalDataTemplate x:Key="PlantillaNodo" DataType="{x:Type local:NodoArchivo}" ItemsSource="{Binding Hijos}">
            <!-- DockPanel y no StackPanel horizontal: así el nombre recibe el ancho que queda y puede cortarse -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Icono}" FontFamily="{StaticResource Iconos}" FontSize="13"
                           Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Chrome.Tenue}" />
                <!-- La ruta (Ver → Mostrar la ruta de las carpetas) sigue al nombre, en gris; si no cabe, se corta -->
                <TextBlock x:Name="Nombre" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Ruta}">
                    <Run Text="{Binding Nombre, Mode=OneWay}" /><Run Text="{Binding Descripcion, Mode=OneWay}" FontSize="12"
                        FontWeight="Normal" Foreground="{DynamicResource Chrome.Tenue}" />
                </TextBlock>
            </DockPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding EsEspacio}" Value="True">
                    <Setter TargetName="Nombre" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EsSeccion}" Value="True">
                    <Setter TargetName="Nombre" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EsActual}" Value="True">
                    <Setter TargetName="Nombre" Property="Foreground" Value="{DynamicResource Acento}" />
                    <Setter TargetName="Nombre" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="Nuevo_Executed" />
        <CommandBinding Command="Open" Executed="Abrir_Executed" />
        <CommandBinding Command="Save" Executed="Guardar_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="SaveAs" Executed="GuardarComo_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.GuardarTodo}" Executed="GuardarTodo_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.CerrarPestana}" Executed="CerrarPestana_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.CerrarTodas}" Executed="CerrarTodas_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.PestanaSiguiente}" Executed="PestanaSiguiente_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.PestanaAnterior}" Executed="PestanaAnterior_Executed" CanExecute="HayPestana_CanExecute" />
        <CommandBinding Command="Close" Executed="Cerrar_Click" />
        <CommandBinding Command="Refresh" Executed="Recargar_Executed" CanExecute="HayArchivo_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.AbrirCarpeta}" Executed="AbrirCarpeta_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.ModoVista}" Executed="ModoVista_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.ModoDividido}" Executed="ModoDividido_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.ModoEditor}" Executed="ModoEditor_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.ModoPro}" Executed="ModoPro_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.VerExplorador}" Executed="VerExplorador_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.VerEsquema}" Executed="VerEsquema_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.VerDocumentos}" Executed="VerDocumentos_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.VerConfiguracion}" Executed="VerConfiguracion_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.Acercar}" Executed="Acercar_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.Alejar}" Executed="Alejar_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.ZoomNormal}" Executed="ZoomNormal_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.AlternarLateral}" Executed="AlternarLateral_Executed" />
        <CommandBinding Command="{x:Static local:Comandos.Negrita}" Executed="Negrita_Executed" CanExecute="EditorVisible_CanExecute" />
        <CommandBinding Command="{x:Static local:Comandos.Cursiva}" Executed="Cursiva_Executed" CanExecute="EditorVisible_CanExecute" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="New" />
        <KeyBinding Key="O" Modifiers="Control" Command="Open" />
        <KeyBinding Key="S" Modifiers="Control" Command="Save" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="SaveAs" />
        <KeyBinding Key="F5" Command="Refresh" />
        <KeyBinding Key="W" Modifiers="Control" Command="{x:Static local:Comandos.CerrarPestana}" />
        <KeyBinding Key="F4" Modifiers="Control" Command="{x:Static local:Comandos.CerrarPestana}" />
        <KeyBinding Key="PageDown" Modifiers="Control" Command="{x:Static local:Comandos.PestanaSiguiente}" />
        <KeyBinding Key="PageUp" Modifiers="Control" Command="{x:Static local:Comandos.PestanaAnterior}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static local:Comandos.ModoVista}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static local:Comandos.ModoDividido}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static local:Comandos.ModoEditor}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static local:Comandos.ModoPro}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{x:Static local:Comandos.VerExplorador}" />
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{x:Static local:Comandos.VerEsquema}" />
        <KeyBinding Key="D" Modifiers="Control+Shift" Command="{x:Static local:Comandos.VerDocumentos}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{x:Static local:Comandos.VerConfiguracion}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{x:Static local:Comandos.Acercar}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{x:Static local:Comandos.Acercar}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{x:Static local:Comandos.Alejar}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{x:Static local:Comandos.Alejar}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{x:Static local:Comandos.ZoomNormal}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{x:Static local:Comandos.ZoomNormal}" />
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{x:Static local:Comandos.AlternarLateral}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{x:Static local:Comandos.Negrita}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{x:Static local:Comandos.Cursiva}" />
    </Window.InputBindings>

    <Border x:Name="Raiz">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="*" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <!-- ===== Barra de título ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="M↓" FontWeight="Bold" FontSize="13" Margin="14,0,8,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Acento}" />

                <!-- Menús: botones planos que abren su lista -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BotonMenu}" Content="_Archivo" Click="AbrirMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                        <MenuItem Header="_Nuevo" Command="New" InputGestureText="Ctrl+N" />
                        <MenuItem Header="_Abrir archivo…" Command="Open" InputGestureText="Ctrl+O" />
                        <MenuItem Header="Agregar _carpeta…" Command="{x:Static local:Comandos.AbrirCarpeta}" />
                        <MenuItem x:Name="MenuRecientes" Header="Abrir _reciente" />
                        <Separator />
                        <MenuItem Header="_Guardar" Command="Save" InputGestureText="Ctrl+S" />
                        <MenuItem Header="Guardar _como…" Command="SaveAs" InputGestureText="Ctrl+Mayús+S" />
                        <MenuItem Header="Guardar _todo" Command="{x:Static local:Comandos.GuardarTodo}" />
                        <Separator />
                        <MenuItem Header="Cerrar _pestaña" Command="{x:Static local:Comandos.CerrarPestana}" InputGestureText="Ctrl+W" />
                        <MenuItem Header="Cerrar to_das las pestañas" Command="{x:Static local:Comandos.CerrarTodas}" />
                        <Separator />
                        <MenuItem Header="_Recargar desde el disco" Command="Refresh" InputGestureText="F5" />
                        <Separator />
                        <MenuItem Header="_Salir" Command="Close" InputGestureText="Alt+F4" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource BotonMenu}" Content="_Editar" Click="AbrirMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                        <MenuItem Header="_Deshacer" Command="Undo" InputGestureText="Ctrl+Z" />
                        <MenuItem Header="_Rehacer" Command="Redo" InputGestureText="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="Cor_tar" Command="Cut" InputGestureText="Ctrl+X" />
                        <MenuItem Header="_Copiar" Command="Copy" InputGestureText="Ctrl+C" />
                        <MenuItem Header="_Pegar" Command="Paste" InputGestureText="Ctrl+V" />
                        <Separator />
                        <MenuItem Header="_Buscar" Command="Find" InputGestureText="Ctrl+F" />
                        <Separator />
                        <MenuItem Header="_Negrita" Command="{x:Static local:Comandos.Negrita}" InputGestureText="Ctrl+B" />
                        <MenuItem Header="_Cursiva" Command="{x:Static local:Comandos.Cursiva}" InputGestureText="Ctrl+I" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource BotonMenu}" Content="_Ver" Click="AbrirMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                        <MenuItem Header="_Vista" Command="{x:Static local:Comandos.ModoVista}" InputGestureText="Ctrl+1" />
                        <MenuItem Header="_Dividido" Command="{x:Static local:Comandos.ModoDividido}" InputGestureText="Ctrl+2" />
                        <MenuItem Header="_Editor" Command="{x:Static local:Comandos.ModoEditor}" InputGestureText="Ctrl+3" />
                        <MenuItem Header="_Pro (por bloques)" Command="{x:Static local:Comandos.ModoPro}" InputGestureText="Ctrl+4" />
                        <Separator />
                        <MenuItem Header="_Documentos" Command="{x:Static local:Comandos.VerDocumentos}" InputGestureText="Ctrl+Mayús+D" />
                        <MenuItem Header="Espacios de _trabajo" Command="{x:Static local:Comandos.VerExplorador}" InputGestureText="Ctrl+Mayús+E" />
                        <MenuItem Header="E_squema" Command="{x:Static local:Comandos.VerEsquema}" InputGestureText="Ctrl+Mayús+O" />
                        <MenuItem x:Name="MenuMostrarRutas" Header="Mostrar la _ruta de las carpetas" IsCheckable="True"
                                  Click="MostrarRutas_Click" />
                        <MenuItem Header="_Configuración" Command="{x:Static local:Comandos.VerConfiguracion}" InputGestureText="Ctrl+," />
                        <Separator />
                        <MenuItem Header="Pestaña _siguiente" Command="{x:Static local:Comandos.PestanaSiguiente}" InputGestureText="Ctrl+Tab" />
                        <MenuItem Header="Pestaña _anterior" Command="{x:Static local:Comandos.PestanaAnterior}" InputGestureText="Ctrl+Mayús+Tab" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource BotonMenu}" Content="A_yuda" Click="AbrirMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="_Repositorio en GitHub" Click="Repositorio_Click" />
                                <MenuItem Header="_Informar un problema…" Click="InformarProblema_Click" />
                                <Separator />
                                <MenuItem Header="_Buscar actualizaciones" Click="BuscarActualizaciones_Click" />
                                <MenuItem Header="_Acerca de MD Codex" Click="AcercaDe_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TituloVentana" Grid.Column="2" FontSize="12" Margin="12,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Chrome.Tenue}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <RadioButton x:Name="BotonVista" GroupName="Modo" Style="{StaticResource AlternarIcono}"
                                 Tag="Vista" Checked="BotonModo_Checked" Content="&#xE890;" ToolTip="Vista (Ctrl+1)" />
                    <RadioButton x:Name="BotonDividido" GroupName="Modo" Style="{StaticResource AlternarIcono}" Margin="2,0"
                                 Tag="Dividido" Checked="BotonModo_Checked" ToolTip="Editor y vista (Ctrl+2)">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1" Data="M1.5,2.5 H14.5 V13.5 H1.5 Z M8,2.5 V13.5" Width="16" Height="16" />
                    </RadioButton>
                    <RadioButton x:Name="BotonEditor" GroupName="Modo" Style="{StaticResource AlternarIcono}"
                                 Tag="Editor" Checked="BotonModo_Checked" Content="&#xE70F;" ToolTip="Editor (Ctrl+3)" />
                    <!-- Separa los modos sobre el texto Markdown del editor por bloques. -->
                    <Rectangle Width="1" Height="16" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource Chrome.Borde}" />
                    <RadioButton x:Name="BotonPro" GroupName="Modo" Style="{StaticResource AlternarIcono}"
                                 Tag="Pro" Checked="BotonModo_Checked" ToolTip="Pro: edición por bloques (Ctrl+4)">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1" Width="16" Height="16"
                              Data="M4.5,2.5 H14 V6.5 H4.5 Z M4.5,9.5 H14 V13.5 H4.5 Z M1.5,3.5 V5.5 M1.5,10.5 V12.5" />
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource BotonVentana}" Content="&#xE921;" Click="Minimizar_Click" ToolTip="Minimizar" />
                    <Button x:Name="BotonMaximizar" Style="{StaticResource BotonVentana}" Content="&#xE922;" Click="Maximizar_Click" ToolTip="Maximizar" />
                    <Button Style="{StaticResource BotonCerrar}" Content="&#xE8BB;" Click="Cerrar_Click" ToolTip="Cerrar" />
                </StackPanel>
            </Grid>

            <!-- ===== Cuerpo ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition x:Name="ColumnaLateral" Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <!-- Barra de actividad; abajo, fijar la barra lateral o dejarla automática -->
                <!-- Por encima de la barra lateral (y opaca), para que esta se esconda debajo al deslizarse -->
                <DockPanel x:Name="BarraActividad" Grid.Column="0" Panel.ZIndex="2" Background="{DynamicResource Chrome.Fondo}">
                    <ToggleButton x:Name="BotonFijarLateral" DockPanel.Dock="Bottom" Style="{StaticResource AlternarIcono}"
                                  Width="36" Height="36" Margin="0,0,0,8" HorizontalAlignment="Center"
                                  Command="{x:Static local:Comandos.AlternarLateral}">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1" Data="M1.5,2.5 H14.5 V13.5 H1.5 Z M5.5,2.5 V13.5" Width="16" Height="16" />
                    </ToggleButton>
                    <!-- Abre la ventana de configuración (queda marcado mientras está abierta) -->
                    <ToggleButton x:Name="ActividadConfiguracion" DockPanel.Dock="Bottom" Style="{StaticResource BotonActividad}"
                                  Command="{x:Static local:Comandos.VerConfiguracion}" Content="&#xE713;" ToolTip="Configuración (Ctrl+,)" />
                    <StackPanel>
                        <ToggleButton x:Name="ActividadDocumentos" Style="{StaticResource BotonActividad}" Tag="Documentos"
                                      Click="Actividad_Click" Content="&#xE7C3;" ToolTip="Documentos (Ctrl+Mayús+D)" />
                        <ToggleButton x:Name="ActividadExplorador" Style="{StaticResource BotonActividad}" Tag="Explorador"
                                      Click="Actividad_Click" Content="&#xE8B7;" ToolTip="Espacios de trabajo (Ctrl+Mayús+E)" />
                        <ToggleButton x:Name="ActividadEsquema" Style="{StaticResource BotonActividad}" Tag="Esquema"
                                      Click="Actividad_Click" Content="&#xE8FD;" ToolTip="Esquema (Ctrl+Mayús+O)" />
                    </StackPanel>
                </DockPanel>

                <!-- Barra lateral: panel propio, un tono entre el marco y el área de trabajo.
                     Automática, flota sobre el área de trabajo (ZIndex) en vez de ocupar su columna. -->
                <Border x:Name="Lateral" Grid.Column="1" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1" Panel.ZIndex="1"
                        Background="{DynamicResource Lateral.Fondo}" BorderBrush="{DynamicResource Chrome.Borde}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DesplazamientoLateral" />
                </Border.RenderTransform>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Height="35" Margin="20,0,8,0">
                        <StackPanel x:Name="AccionesExplorador" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BotonIcono}" FontSize="14" Content="&#xE710;"
                                    Click="NuevoEspacio_Click" ToolTip="Nuevo espacio de trabajo…" />
                            <Button Style="{StaticResource BotonIcono}" FontSize="14" Content="&#xED25;"
                                    Command="{x:Static local:Comandos.AbrirCarpeta}" ToolTip="Agregar carpeta al espacio seleccionado…" />
                            <Button Style="{StaticResource BotonIcono}" FontSize="14" Content="&#xE72C;"
                                    Click="RefrescarArbol_Click" ToolTip="Actualizar el explorador" />
                        </StackPanel>
                        <TextBlock x:Name="TituloLateral" Style="{StaticResource EtiquetaTenue}" Text="EXPLORADOR" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <!-- Pide un nombre (archivo nuevo, espacio de trabajo): Enter acepta, Esc o un clic fuera cancela -->
                    <StackPanel x:Name="FilaNombre" DockPanel.Dock="Top" Margin="24,0,12,0" Visibility="Collapsed">
                        <!-- Aparece desplegándose hacia abajo (se anima ScaleY) -->
                        <StackPanel.LayoutTransform>
                            <ScaleTransform x:Name="EscalaFilaNombre" />
                        </StackPanel.LayoutTransform>
                        <TextBlock x:Name="EtiquetaNombre" FontSize="11" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Chrome.Tenue}" />
                        <!-- Sin margen inferior: queda pegada al árbol como una fila más -->
                        <DockPanel>
                        <!-- Ícono del espacio de trabajo, a la izquierda como en el árbol; no toma el foco -->
                        <!-- Mismo tamaño que una fila del árbol (ícono y texto de 13) -->
                        <Button x:Name="BotonElegirIcono" DockPanel.Dock="Left" Style="{StaticResource BotonIcono}" FontSize="13"
                                Width="22" Height="24" Margin="0,0,2,0" Click="BotonElegirIcono_Click" ToolTip="Elegir ícono"
                                Visibility="Collapsed" />
                        <Grid>
                            <TextBox x:Name="CajaNombre" FontSize="13" MinHeight="0" Height="24" Padding="6,0" VerticalContentAlignment="Center"
                                     KeyDown="CajaNombre_KeyDown" LostKeyboardFocus="CajaNombre_LostKeyboardFocus" />
                            <!-- Marcador: se ve mientras la caja está vacía -->
                            <TextBlock x:Name="MarcadorNombre" IsHitTestVisible="False" Margin="8,0,8,0" VerticalAlignment="Center" FontSize="13"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Chrome.Tenue}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=CajaNombre}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        </DockPanel>
                        <!-- Íconos para elegir, flotando sobre lo de abajo. Ni la ventana emergente ni los botones
                             toman el foco, así la caja de texto sigue abierta. Un clic fuera la cierra. -->
                        <Popup x:Name="SelectorIconos" PlacementTarget="{Binding ElementName=BotonElegirIcono}" Placement="Bottom"
                               VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Margin="0,0,8,8" Padding="6" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource Lateral.Fondo}" BorderBrush="{DynamicResource Chrome.Borde}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                                </Border.Effect>
                                <WrapPanel x:Name="PanelIconos" Width="240" />
                            </Border>
                        </Popup>
                    </StackPanel>
                    <Grid>
                        <Grid x:Name="PanelExplorador">
                            <!-- Sin desplazamiento horizontal: los nombres largos se cortan con "…" antes del margen derecho -->
                            <TreeView x:Name="Arbol" Background="Transparent" BorderThickness="0" Padding="6,0,12,0"
                                      ItemContainerStyle="{StaticResource EstiloNodo}" ItemTemplate="{StaticResource PlantillaNodo}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseLeftButtonUp="Arbol_PreviewMouseLeftButtonUp" KeyDown="Arbol_KeyDown"
                                      MouseDoubleClick="Arbol_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="Arbol_PreviewMouseRightButtonDown"
                                      ContextMenuOpening="Arbol_ContextMenuOpening"
                                      AllowDrop="True" PreviewMouseLeftButtonDown="Arbol_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="Arbol_PreviewMouseMove" DragOver="Arbol_DragOver" Drop="Arbol_Drop"
                                      TreeViewItem.Expanded="Arbol_Expandido" TreeViewItem.Collapsed="Arbol_Plegado">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="MenuAbrirExplorador" Header="Abrir en el Explorador" Click="AbrirEnExplorador_Click" />
                                        <Separator />
                                        <MenuItem x:Name="MenuNuevoArchivoArbol" Header="Nuevo archivo…" Click="NuevoArchivo_Click" />
                                        <MenuItem Header="Agregar carpeta…" Click="AgregarCarpeta_Click" />
                                        <MenuItem x:Name="MenuQuitarCarpeta" Header="Quitar carpeta del espacio de trabajo" Click="QuitarCarpeta_Click" />
                                        <Separator />
                                        <MenuItem Header="Nuevo espacio de trabajo…" Click="NuevoEspacio_Click" />
                                        <MenuItem x:Name="MenuRenombrarEspacio" Header="Editar nombre e ícono…" Click="RenombrarEspacio_Click" />
                                        <MenuItem x:Name="MenuEliminarEspacio" Header="Eliminar espacio de trabajo" Click="EliminarEspacio_Click" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>
                            <!-- Al reordenar espacios de trabajo, la línea marca dónde quedaría el que se arrastra -->
                            <Canvas x:Name="CapaArrastre" IsHitTestVisible="False">
                                <Border x:Name="LineaDestino" Height="2" CornerRadius="1" Background="{DynamicResource Acento}" Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                        <ListBox x:Name="ListaEsquema" Background="Transparent" BorderThickness="0" Padding="6,0"
                                 PreviewMouseLeftButtonUp="ListaEsquema_PreviewMouseLeftButtonUp">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="10,4" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:Titulo}">
                                    <TextBlock Text="{Binding Texto}" Margin="{Binding Sangria}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EsquemaVacio" Text="El documento no tiene títulos." Margin="20,4,16,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Chrome.Tenue}" />
                        <!-- Documentos: abiertos fuera de los espacios de trabajo, y recientes -->
                        <DockPanel x:Name="PanelDocumentos" Visibility="Collapsed">
                            <TextBlock x:Name="DocumentosVacio" DockPanel.Dock="Top" Margin="20,4,16,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Chrome.Tenue}"
                                       Text="Aquí aparecen los documentos abiertos que no están en un espacio de trabajo y los recientes." />
                            <TreeView x:Name="ArbolDocumentos" Background="Transparent" BorderThickness="0" Padding="6,0,12,0"
                                      ItemContainerStyle="{StaticResource EstiloNodo}" ItemTemplate="{StaticResource PlantillaNodo}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseLeftButtonUp="Arbol_PreviewMouseLeftButtonUp" KeyDown="Arbol_KeyDown"
                                      MouseDoubleClick="Arbol_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="Arbol_PreviewMouseRightButtonDown"
                                      ContextMenuOpening="ArbolDocumentos_ContextMenuOpening"
                                      TreeViewItem.Expanded="Arbol_Expandido" TreeViewItem.Collapsed="Arbol_Plegado">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Abrir en el Explorador" Click="AbrirEnExplorador_Click" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>
                        </DockPanel>
                    </Grid>
                </DockPanel>
                </Border>

                <GridSplitter x:Name="DivisorLateral" Grid.Column="2" Width="8" Style="{StaticResource Divisor}" />

                <!-- Espacio de trabajo: pestañas tipo carpeta de archivador sobre un panel redondeado -->
                <Grid Grid.Column="3" Margin="0,0,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Bajan 1 px sobre el borde superior del panel: la pestaña activa lo tapa y se une a él -->
                    <ScrollViewer x:Name="DesplazadorPestanas" Grid.Row="0" Height="37" Margin="0,0,0,-1" Panel.ZIndex="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="DesplazadorPestanas_PreviewMouseWheel">
                        <ItemsControl x:Name="BarraPestanas" Margin="0,3,0,0" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:Pestana}">
                                    <Border x:Name="Fondo" Height="34" MinWidth="90" MaxWidth="240" Padding="12,0,6,0" Margin="0,0,2,0"
                                            Background="Transparent" CornerRadius="8,8,0,0"
                                            BorderThickness="1,1,1,0" BorderBrush="Transparent"
                                            ToolTip="{Binding Descripcion}" MouseDown="Pestana_MouseDown">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Cerrar" InputGestureText="Ctrl+W" Click="MenuCerrar_Click" />
                                                <MenuItem Header="Cerrar otras" Click="MenuCerrarOtras_Click" />
                                                <MenuItem Header="Cerrar a la derecha" Click="MenuCerrarDerecha_Click" />
                                                <MenuItem Header="Cerrar todas" Click="MenuCerrarTodas_Click" />
                                                <Separator />
                                                <MenuItem Header="Copiar ruta" Click="MenuCopiarRuta_Click" IsEnabled="{Binding TieneRuta}" />
                                                <MenuItem Header="Mostrar en el Explorador de Windows" Click="MenuMostrarEnCarpeta_Click" IsEnabled="{Binding TieneRuta}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <Button x:Name="Cerrar" DockPanel.Dock="Right" Style="{StaticResource BotonCerrarPestana}"
                                                    Margin="6,0,0,0" Opacity="0" Click="CerrarPestana_Click" ToolTip="Cerrar (Ctrl+W)" />
                                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Iconos}" FontSize="13" Margin="0,0,6,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Acento}" />
                                            <TextBlock x:Name="Nombre" Text="{Binding Nombre}" FontSize="13" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Chrome.Tenue}" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Fondo}" Value="True">
                                            <Setter TargetName="Cerrar" Property="Opacity" Value="1" />
                                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Modificado}" Value="True">
                                            <Setter TargetName="Cerrar" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EsTemporal}" Value="True">
                                            <Setter TargetName="Nombre" Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Editor.Fondo}" />
                                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource Chrome.Borde}" />
                                            <Setter TargetName="Nombre" Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
                                            <Setter TargetName="Cerrar" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border x:Name="Tarjeta" Grid.Row="1" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource Chrome.Borde}" Background="{DynamicResource Editor.Fondo}">
                    <Grid x:Name="AreaTrabajo">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnaEditor" Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="ColumnaVista" Width="*" />
                        </Grid.ColumnDefinitions>
                        <ae:TextEditor x:Name="Editor" Grid.Column="0" FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                       ShowLineNumbers="True" WordWrap="True" Padding="12,16,16,16" />
                        <GridSplitter x:Name="Divisor" Grid.Column="1" Width="8" Style="{StaticResource DivisorVisible}" />
                        <!-- Control de composición: se dibuja dentro de WPF, así respeta las esquinas redondeadas del panel -->
                        <wv2:WebView2CompositionControl x:Name="Visor" Grid.Column="2" />
                        <!-- Modo Pro: editor por bloques (Milkdown Crepe). Se inicia la primera vez que se usa. -->
                        <wv2:WebView2CompositionControl x:Name="VisorPro" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed" />
                    </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Aviso discreto de nueva versión, en la esquina del área de trabajo -->
            <Border x:Name="AvisoActualizacion" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,20" Padding="14,10,6,12" Width="300" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource Lateral.Fondo}" BorderBrush="{DynamicResource Chrome.Borde}" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource BotonIcono}" FontSize="10"
                            Width="24" Height="24" Content="&#xE8BB;" Click="CerrarAviso_Click" ToolTip="Cerrar" />
                    <TextBlock DockPanel.Dock="Left" Text="&#xE896;" FontFamily="{StaticResource Iconos}" FontSize="16"
                               Margin="0,2,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Acento}" />
                    <StackPanel Margin="0,2,0,0">
                        <TextBlock x:Name="TextoActualizacion" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Margin="0,6,0,0">
                            <Hyperlink Click="Actualizar_Click" Foreground="{DynamicResource Acento}"><Run x:Name="AccionActualizacion" Text="Actualizar" /></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Configuración: ventana modal sobre el área de trabajo y la barra de estado =====
                 Fondo oscurecido (un clic ahí la cierra, igual que Esc o la ✕), categorías a la izquierda y
                 sus opciones a la derecha. Los sí/no son interruptores (Interruptor_Click, por x:Name);
                 las listas, selects (Selector_SelectionChanged, por x:Name y el Tag de cada opción). -->
            <Grid x:Name="CapaConfiguracion" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="Collapsed"
                  KeyDown="CapaConfiguracion_KeyDown">
                <Border Background="#99000000" MouseLeftButtonDown="FondoConfiguracion_MouseLeftButtonDown" />
                <Border MaxWidth="820" MaxHeight="560" Margin="32" CornerRadius="10" BorderThickness="1"
                        Background="{DynamicResource Editor.Fondo}" BorderBrush="{DynamicResource Chrome.Borde}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Categorías -->
                        <Border CornerRadius="9,0,0,9" Background="{DynamicResource Lateral.Fondo}"
                                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Chrome.Borde}">
                            <StackPanel Margin="10,16,10,10">
                                <TextBlock Style="{StaticResource EtiquetaTenue}" Text="CONFIGURACIÓN" Margin="10,0,0,12" />
                                <!-- Tag: la sección que muestra; el texto (segundo hijo) es también el título de la derecha -->
                                <RadioButton x:Name="CategoriaInicial" GroupName="Categoria" Tag="SeccionGeneral" Style="{StaticResource CategoriaConfiguracion}" Checked="Categoria_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource IconoCategoria}" />
                                        <TextBlock Text="General" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Categoria" Tag="SeccionEditor" Style="{StaticResource CategoriaConfiguracion}" Checked="Categoria_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" Style="{StaticResource IconoCategoria}" />
                                        <TextBlock Text="Editor de texto" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Categoria" Tag="SeccionVista" Style="{StaticResource CategoriaConfiguracion}" Checked="Categoria_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE890;" Style="{StaticResource IconoCategoria}" />
                                        <TextBlock Text="Vista previa" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Categoria" Tag="SeccionBloques" Style="{StaticResource CategoriaConfiguracion}" Checked="Categoria_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8FD;" Style="{StaticResource IconoCategoria}" />
                                        <TextBlock Text="Editor por bloques" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="CategoriaImagenes" GroupName="Categoria" Tag="SeccionImagenes" Style="{StaticResource CategoriaConfiguracion}" Checked="Categoria_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9F;" Style="{StaticResource IconoCategoria}" />
                                        <TextBlock Text="Imágenes" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- Opciones de la categoría elegida -->
                        <DockPanel Grid.Column="1">
                            <DockPanel DockPanel.Dock="Top" Margin="28,14,12,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BotonIcono}" FontSize="11" Width="30" Height="30"
                                        Content="&#xE8BB;" Click="CerrarConfiguracion_Click" ToolTip="Cerrar (Esc)" />
                                <TextBlock x:Name="TituloCategoria" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                <Grid Margin="28,8,28,28" MaxWidth="520" HorizontalAlignment="Left">
                                    <StackPanel x:Name="SeccionGeneral">
                                        <TextBlock Text="Tema" FontSize="13" />
                                        <ComboBox x:Name="SelectorTema" Style="{StaticResource Selector}" Margin="0,6,0,20" SelectionChanged="Selector_SelectionChanged">
                                            <ComboBoxItem Tag="Sistema" Content="Igual que Windows" />
                                            <ComboBoxItem Tag="Claro" Content="Claro" />
                                            <ComboBoxItem Tag="Oscuro" Content="Oscuro" />
                                        </ComboBox>
                                        <TextBlock Text="Modo al abrir" FontSize="13" />
                                        <TextBlock Style="{StaticResource ExplicacionConfiguracion}" Text="Cómo se ven los documentos al iniciar MD Codex." />
                                        <ComboBox x:Name="SelectorModoInicial" Style="{StaticResource Selector}" Margin="0,6,0,20" SelectionChanged="Selector_SelectionChanged">
                                            <ComboBoxItem Tag="Ultimo" Content="El de la última vez" />
                                            <ComboBoxItem Tag="Vista" Content="Vista" />
                                            <ComboBoxItem Tag="Dividido" Content="Editor y vista" />
                                            <ComboBoxItem Tag="Editor" Content="Editor" />
                                            <ComboBoxItem Tag="Pro" Content="Por bloques" />
                                        </ComboBox>
                                        <DockPanel Margin="0,0,0,20">
                                            <CheckBox x:Name="OpcionReabrirSesion" DockPanel.Dock="Right" Style="{StaticResource Interruptor}"
                                                      VerticalAlignment="Top" Margin="16,1,0,0" Click="Interruptor_Click" ToolTip="Reabrir la sesión anterior" />
                                            <StackPanel>
                                                <TextBlock Text="Reabrir la sesión anterior" FontSize="13" />
                                                <TextBlock Style="{StaticResource ExplicacionConfiguracion}" Text="Al iniciar sin un archivo, vuelve a abrir las pestañas de la última vez." />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="Si un archivo cambia fuera de la app" FontSize="13" />
                                        <TextBlock Style="{StaticResource ExplicacionConfiguracion}" Text="Si tiene cambios sin guardar, siempre pregunta antes de recargarlo." />
                                        <ComboBox x:Name="SelectorCambioExterno" Style="{StaticResource Selector}" Margin="0,6,0,20" SelectionChanged="Selector_SelectionChanged">
                                            <ComboBoxItem Tag="Recargar" Content="Recargarlo" />
                                            <ComboBoxItem Tag="Preguntar" Content="Preguntar siempre" />
                                        </ComboBox>
                                        <DockPanel>
                                            <CheckBox x:Name="OpcionBuscarActualizaciones" DockPanel.Dock="Right" Style="{StaticResource Interruptor}"
                                                      VerticalAlignment="Top" Margin="16,1,0,0" Click="Interruptor_Click" ToolTip="Buscar actualizaciones al iniciar" />
                                            <StackPanel>
                                                <TextBlock Text="Buscar actualizaciones al iniciar" FontSize="13" />
                                                <TextBlock Style="{StaticResource ExplicacionConfiguracion}" Text="Avisa cuando hay una versión nueva en GitHub." />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="BotonBuscarActualizaciones" Style="{StaticResource BotonSecundario}"
                                                    Content="Buscar ahora" Click="BuscarActualizaciones_Click" />
                                            <TextBlock x:Name="ResultadoBusqueda" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                       TextWrapping="Wrap" MaxWidth="360" Foreground="{DynamicResource Chrome.Tenue}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="SeccionEditor" Visibility="Collapsed">
                                        <DockPanel Margin="0,0,0,20">
                                            <CheckBox x:Name="OpcionAjustarLineas" DockPanel.Dock="Right" Style="{StaticResource Interruptor}"
                                                      VerticalAlignment="Top" Margin="16,1,0,0" Click="Interruptor_Click" ToolTip="Ajustar las líneas largas" />
                                            <StackPanel>
                                                <TextBlock Text="Ajustar las líneas largas" FontSize="13" />
                                                <TextBlock Style="{StaticResource ExplicacionConfiguracion}"
                                                           Text="Las líneas que no caben siguen abajo. Desactivado, siguen hacia la derecha y el editor se desplaza en horizontal." />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,20">
                                            <CheckBox x:Name="OpcionNumerosLinea" DockPanel.Dock="Right" Style="{StaticResource Interruptor}"
                                                      VerticalAlignment="Top" Margin="16,1,0,0" Click="Interruptor_Click" ToolTip="Mostrar los números de línea" />
                                            <TextBlock Text="Mostrar los números de línea" FontSize="13" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,20">
                                            <CheckBox x:Name="OpcionResaltarLinea" DockPanel.Dock="Right" Style="{StaticResource Interruptor}"
                                                      VerticalAlignment="Top" Margin="16,1,0,0" Click="Interruptor_Click" ToolTip="Resaltar la línea actual" />
                                            <TextBlock Text="Resaltar la línea actual" FontSize="13" />
                                        </DockPanel>
                                        <TextBlock Text="Guardado automático" FontSize="13" />
                                        <TextBlock Style="{StaticResource ExplicacionConfiguracion}" Text="Solo para documentos que ya tienen archivo." />
                                        <ComboBox x:Name="SelectorGuardado" Style="{StaticResource Selector}" Margin="0,6,0,0" SelectionChanged="Selector_SelectionChanged">
                                            <ComboBoxItem Tag="Desactivado" Content="Desactivado" />
                                            <ComboBoxItem Tag="AlCambiar" Content="Al cambiar de pestaña o de ventana" />
                                            <ComboBoxItem Tag="AlDejarDeEscribir" Content="Al dejar de escribir" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel x:Name="SeccionVista" Visibility="Collapsed">
                                        <TextBlock Text="Ancho del texto" FontSize="13" />
                                        <ComboBox x:Name="SelectorAnchoVista" Style="{StaticResource Selector}" Margin="0,6,0,20" SelectionChanged="Selector_SelectionChanged">
                                            <ComboBoxItem Tag="Compacto" Content="Compacto, centrado" />
                                            <ComboBoxItem Tag="Completo" Content="Todo el ancho" />
                                        </ComboBox>
                                        <DockPanel>
                                            <CheckBox x:Name="OpcionSincronizarDesplazamiento" DockPanel.Dock="Right" Style="{StaticResource Interruptor}"
                                                      VerticalAlignment="Top" Margin="16,1,0,0" Click="Interruptor_Click" ToolTip="Sincronizar el desplazamiento" />
                                            <StackPanel>
                                                <TextBlock Text="Sincronizar el desplazamiento" FontSize="13" />
                                                <TextBlock Style="{StaticResource ExplicacionConfiguracion}" Text="En Editor y vista, al desplazar uno el otro lo sigue." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="SeccionBloques" Visibility="Collapsed">
                                        <TextBlock Text="Ancho del texto" FontSize="13" />
                                        <ComboBox x:Name="SelectorAnchoBloques" Style="{StaticResource Selector}" Margin="0,6,0,0" SelectionChanged="Selector_SelectionChanged">
                                            <ComboBoxItem Tag="Compacto" Content="Compacto, centrado" />
                                            <ComboBoxItem Tag="Completo" Content="Todo el ancho" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel x:Name="SeccionImagenes" Visibility="Collapsed">
                                        <TextBlock Text="Carpeta de las imágenes" FontSize="13" />
                                        <TextBlock Style="{StaticResource ExplicacionConfiguracion}"
                                                   Text="Las imágenes que pegas o arrastras en el editor por bloques se copian aquí y el documento las enlaza. Si la carpeta no existe, se crea." />
                                        <TextBox x:Name="CajaCarpetaImagenes" Style="{StaticResource CajaConfiguracion}" Margin="0,8,0,0"
                                                 KeyDown="CajaCarpetaImagenes_KeyDown" LostKeyboardFocus="CajaCarpetaImagenes_LostKeyboardFocus"
                                                 ToolTip="Ruta completa, o solo un nombre (por ejemplo, imagenes) para una carpeta junto a cada documento" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource BotonSecundario}" Content="Seleccionar carpeta…" Click="SeleccionarCarpetaImagenes_Click" />
                                            <Button Style="{StaticResource BotonSecundario}" Content="Usar la predeterminada" Margin="8,0,0,0"
                                                    Click="CarpetaImagenesPredeterminada_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="DetalleCarpetaImagenes" Style="{StaticResource ExplicacionConfiguracion}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Barra de estado ===== -->
            <Grid Grid.Row="2" Background="{DynamicResource Estado.Fondo}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0">
                    <Button Style="{StaticResource ItemEstado}" Command="{x:Static local:Comandos.AbrirCarpeta}" ToolTip="Abrir carpeta…">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Iconos}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="EstadoCarpeta" Text="Sin carpeta" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EstadoModo" Style="{StaticResource ItemEstado}" Click="EstadoModo_Click" ToolTip="Cambiar de modo" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button x:Name="EstadoActualizacion" Style="{StaticResource ItemEstado}" Visibility="Collapsed"
                            Click="Actualizar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Iconos}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TextoEstadoActualizacion" Text="Actualización pendiente" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Zoom de lo que se está viendo: alejar, porcentaje (clic: volver al 100 %) y acercar -->
                    <Button Style="{StaticResource ItemEstado}" Command="{x:Static local:Comandos.Alejar}" ToolTip="Alejar (Ctrl+-)"
                            Content="&#xE738;" FontFamily="{StaticResource Iconos}" FontSize="10" />
                    <Button x:Name="EstadoZoom" Style="{StaticResource ItemEstado}" Command="{x:Static local:Comandos.ZoomNormal}"
                            ToolTip="Zoom. Clic para volver al 100 % (Ctrl+0)" Content="100 %" />
                    <Button Style="{StaticResource ItemEstado}" Command="{x:Static local:Comandos.Acercar}" ToolTip="Acercar (Ctrl++)"
                            Content="&#xE710;" FontFamily="{StaticResource Iconos}" FontSize="10" Margin="0,0,8,0" />
                    <Button x:Name="EstadoPosicion" Style="{StaticResource ItemEstado}" />
                    <Button x:Name="EstadoPalabras" Style="{StaticResource ItemEstado}" />
                    <Button x:Name="EstadoCodificacion" Style="{StaticResource ItemEstado}" ToolTip="Codificación del archivo" />
                    <Button x:Name="EstadoFinLinea" Style="{StaticResource ItemEstado}" ToolTip="Fin de línea" />
                    <Button x:Name="EstadoLenguaje" Style="{StaticResource ItemEstado}" Content="Markdown" />
                    <!-- Marca del desarrollador -->
                    <Button Style="{StaticResource ItemEstado}" Click="AcercaDe_Click" ToolTip="skolldev · Acerca de MD Codex">
                        <Rectangle Width="14" Height="14" Fill="{DynamicResource Estado.Texto}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Recursos/skolldev-silueta.png" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
