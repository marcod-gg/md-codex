<Window x:Class="MdCodex.AcercaDe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MdCodex"
        Title="Acerca de MD Codex" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Chrome.Fondo}" Foreground="{DynamicResource Chrome.Texto}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Width="380">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Acerca de MD Codex" FontSize="12" Margin="14,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource Chrome.Tenue}" />
        <Button Style="{StaticResource BotonCerrar}" Content="&#xE8BB;" HorizontalAlignment="Right" Height="32"
                Click="Cerrar_Click" ToolTip="Cerrar" />

        <StackPanel Grid.Row="1" Margin="32,8,32,28" HorizontalAlignment="Center">
            <!-- Logo del desarrollador pintado con el color del texto: se adapta al tema -->
            <Rectangle Width="112" Height="112" Fill="{DynamicResource Chrome.Texto}" HorizontalAlignment="Center">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="/Recursos/skolldev.png" Stretch="Uniform" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <TextBlock Text="MD Codex" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
            <TextBlock x:Name="TextoVersion" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"
                       Foreground="{DynamicResource Chrome.Tenue}" />
            <TextBlock Text="Visor y editor de Markdown para Windows" FontSize="13" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
            <Rectangle Height="1" Margin="0,20" Fill="{DynamicResource Chrome.Borde}" />
            <TextBlock HorizontalAlignment="Center" FontSize="13">
                <Run Text="Desarrollado por" Foreground="{DynamicResource Chrome.Tenue}" />
                <Run Text="{x:Static local:Marca.Autor}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock x:Name="TextoCopyright" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"
                       Foreground="{DynamicResource Chrome.Tenue}" />
            <TextBlock HorizontalAlignment="Center" FontSize="12" Margin="0,10,0,0">
                <Hyperlink NavigateUri="{x:Static local:Marca.RepositorioUri}" RequestNavigate="Enlace_RequestNavigate"
                           Foreground="{DynamicResource Acento}" TextDecorations="None" ToolTip="{x:Static local:Marca.Repositorio}">
                    <Run Text="{x:Static local:Marca.RepositorioCorto}" />
                </Hyperlink>
            </TextBlock>
            <Button Content="Cerrar" Click="Cerrar_Click" IsDefault="True" IsCancel="True"
                    HorizontalAlignment="Center" MinWidth="110" Margin="0,24,0,0" />
        </StackPanel>
    </Grid>
</Window>
