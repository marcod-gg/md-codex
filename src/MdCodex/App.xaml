<Application x:Class="MdCodex.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="Iconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Valores de arranque (tema oscuro); MainWindow.AplicarTema los reemplaza según el tema de Windows. -->
        <SolidColorBrush x:Key="Chrome.Fondo" Color="#010409" />
        <SolidColorBrush x:Key="Chrome.Borde" Color="#3D444D" />
        <SolidColorBrush x:Key="Chrome.Texto" Color="#E6EDF3" />
        <SolidColorBrush x:Key="Chrome.Tenue" Color="#9198A1" />
        <SolidColorBrush x:Key="Chrome.Hover" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="Chrome.Activo" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="Acento" Color="#4493F8" />
        <SolidColorBrush x:Key="Lateral.Fondo" Color="#11161D" />
        <SolidColorBrush x:Key="Editor.Fondo" Color="#1F242B" />
        <SolidColorBrush x:Key="Estado.Fondo" Color="#0078D4" />
        <SolidColorBrush x:Key="Estado.Texto" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Estado.Hover" Color="#26FFFFFF" />

        <!-- Botón de ícono (barra de título y encabezados de la barra lateral) -->
        <Style x:Key="BotonIcono" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Tenue}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource Iconos}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlternarIcono" TargetType="ToggleButton" BasedOn="{StaticResource BotonIcono}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Chrome.Activo}" />
                    <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Menús de texto de la barra de título -->
        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Activo}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones de minimizar, maximizar y cerrar -->
        <Style x:Key="BotonVentana" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource Iconos}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Tag" Value="{DynamicResource Chrome.Hover}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonCerrar" TargetType="Button" BasedOn="{StaticResource BotonVentana}">
            <Setter Property="Tag" Value="#C42B1C" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Íconos de la barra de actividad, con la marca de acento a la izquierda cuando están activos -->
        <Style x:Key="BotonActividad" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Tenue}" />
            <Setter Property="FontFamily" Value="{StaticResource Iconos}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Fondo" Margin="6,4" CornerRadius="8" Background="Transparent" />
                            <Border x:Name="Marca" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource Acento}" Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                                <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de cerrar de una pestaña: muestra ● si hay cambios sin guardar, y ✕ al pasar el mouse -->
        <Style x:Key="BotonCerrarPestana" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Grid>
                                <TextBlock x:Name="Equis" Text="&#xE8BB;" FontFamily="{StaticResource Iconos}" FontSize="9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse x:Name="Punto" Width="8" Height="8" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Modificado}" Value="True">
                                <Setter TargetName="Equis" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Punto" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                                <Setter TargetName="Equis" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Punto" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Elementos de la barra de estado -->
        <Style x:Key="ItemEstado" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Estado.Texto}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="1,2" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Estado.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Divisores: invisibles hasta pasar el mouse; entonces una línea fina al centro.
             Toda la franja sigue sirviendo para arrastrar. -->
        <Style x:Key="Divisor" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Width="2" HorizontalAlignment="Center" CornerRadius="1" Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Acento}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Acento}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Divisor entre el editor y la vista: siempre visible, con el acento al pasar el mouse o arrastrar. -->
        <Style x:Key="DivisorVisible" TargetType="GridSplitter" BasedOn="{StaticResource Divisor}">
            <Setter Property="Background" Value="{DynamicResource Chrome.Borde}" />
        </Style>

        <!-- Interruptor de la configuración: píldora que se llena con el acento al activarse -->
        <Style x:Key="Interruptor" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="36" Height="20" Background="Transparent">
                            <Border x:Name="Pista" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource Chrome.Tenue}" Background="Transparent" />
                            <Ellipse x:Name="Perilla" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource Chrome.Tenue}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pista" Property="BorderBrush" Value="{DynamicResource Chrome.Texto}" />
                                <Setter TargetName="Perilla" Property="Fill" Value="{DynamicResource Chrome.Texto}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pista" Property="Background" Value="{DynamicResource Acento}" />
                                <Setter TargetName="Pista" Property="BorderBrush" Value="{DynamicResource Acento}" />
                                <Setter TargetName="Perilla" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Perilla" Property="Fill" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pista" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Categoría de la ventana de configuración: fila con ícono; la elegida, con fondo y la marca de acento -->
        <Style x:Key="CategoriaConfiguracion" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Fondo" Background="Transparent" CornerRadius="6" Padding="10,7">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Marca" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource Acento}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Activo}" />
                                <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconoCategoria" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Iconos}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Tenue}" />
        </Style>

        <!-- Opción de un select: fila con un ✓ en la elegida -->
        <Style x:Key="OpcionSelector" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Fondo" Background="Transparent" CornerRadius="4" Padding="8,6,16,6">
                            <DockPanel>
                                <TextBlock x:Name="Marca" DockPanel.Dock="Left" Width="20" Text="&#xE73E;" FontSize="12"
                                           FontFamily="{StaticResource Iconos}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Acento}" Visibility="Hidden" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Select de la configuración: caja con la opción elegida y una flecha; la lista se despliega debajo -->
        <Style x:Key="Selector" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="260" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource OpcionSelector}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Caja" Focusable="False" ClickMode="Press" Style="{x:Null}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Borde" CornerRadius="6" BorderThickness="1"
                                                BorderBrush="{DynamicResource Chrome.Borde}" Background="{DynamicResource Lateral.Fondo}">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Iconos}" FontSize="10" Margin="0,0,12,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Chrome.Tenue}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Chrome.Tenue}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Acento}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,4,10,10" Padding="4" CornerRadius="6" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource Lateral.Fondo}" BorderBrush="{DynamicResource Chrome.Borde}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de texto de la configuración (Buscar ahora, Seleccionar carpeta…) -->
        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" CornerRadius="6" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource Chrome.Borde}" Background="{DynamicResource Lateral.Fondo}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Hover}" />
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource Chrome.Tenue}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource Acento}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Chrome.Activo}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caja de texto de la configuración, con los colores del tema -->
        <Style x:Key="CajaConfiguracion" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Texto}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Chrome.Texto}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Acento}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Borde" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource Chrome.Borde}" Background="{DynamicResource Lateral.Fondo}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Chrome.Tenue}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Acento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplicacionConfiguracion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Tenue}" />
        </Style>

        <Style x:Key="EtiquetaTenue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Tenue}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
