<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versión de Windows explícita: WebView2CompositionControl usa las proyecciones del SDK de Windows. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Product>MD Codex</Product>
    <Description>Visor y editor de Markdown para Windows</Description>
    <Company>skolldev</Company>
    <Authors>Marco González G.</Authors>
    <Copyright>© 2026 Marco González G.</Copyright>
    <Version>1.3.7</Version>
    <RepositoryUrl>https://github.com/marcod-gg/md-codex</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/marcod-gg/md-codex</PackageProjectUrl>
    <!-- Generado con marca\generar-icono-app.ps1 -->
    <ApplicationIcon>Recursos\mdcodex.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Fuente web (Vite, node_modules): no es parte de la compilación de .NET. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Web\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Recursos\mdcodex.ico" />
    <Resource Include="Recursos\skolldev.png" />
    <!-- Silueta rellena: a tamaños pequeños el logo de líneas se vuelve una mancha. -->
    <Resource Include="Recursos\skolldev-silueta.png" />
  </ItemGroup>

  <!-- Editor por bloques del modo Pro, compilado desde Web con "npm run build". -->
  <ItemGroup>
    <None Include="Pro\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Librerías de la vista previa (resaltado de código, diagramas), copiadas con "npm run vista". -->
    <None Include="Vista\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
